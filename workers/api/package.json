{
  "name": "@atb/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "validate": "wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "hash-password": "node scripts/hash-password.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest --run"
  },
  "dependencies": {
    "@atb/shared-types": "workspace:*",
    "@atb/trading-core": "workspace:*",
    "@atb/validation": "workspace:*",
    "hono": "^4.13.11",
    "zod": "^4.1.0",
    "@atb/brokers": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.1",
    "wrangler": "^4.144.0"
  }
}
