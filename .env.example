# =====================================================================
# AI Trading Bot V3 — environment template. NEVER commit real values.
# Worker secrets:  `wrangler secret put <NAME> --env <env>` (local: workers/api/.dev.vars)
# Gateway secrets: /opt/atb/.env on the VM (chmod 600), injected via docker compose.
# =====================================================================

# ---------- Cloudflare (CI / deploy only) ----------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=
R2_BUCKET=atb-artifacts
QUEUE_NAME=atb-trade-events

# ---------- Worker <-> Gateway <-> AI (shared HMAC secrets, 32+ random bytes) ----------
GATEWAY_URL=https://gateway.example.com
GATEWAY_HMAC_SECRET=
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_SECRET=

# ---------- Auth (owner-only, personal use) ----------
JWT_SECRET=
OWNER_EMAIL=
# bcrypt/PBKDF2 hash generated with `pnpm --filter @atb/api run hash-password`
OWNER_PASSWORD_HASH=
# Optional: Cloudflare Access application AUD tag (Zero Trust in front of the API)
CF_ACCESS_AUD=

# ---------- Execution Gateway (runs on static-IP VM) ----------
GATEWAY_NODE_ID=azure-cin-1            # azure-cin-1 (primary) | do-blr-1 (secondary)
GATEWAY_PORT=8080
# Comma separated static IPs whitelisted at the broker (max 2: primary,secondary)
WHITELISTED_EGRESS_IPS=
EGRESS_IP_CHECK_URL=https://api.ipify.org
# Hard cap well below the exchange ~10 orders/sec retail threshold
MAX_ORDERS_PER_SECOND=5
ACTIVE_BROKER=paper                    # paper | zerodha | upstox | dhan | angelone | fyers | ...

# ---------- Broker credentials (fill only the broker(s) you use) ----------
# Zerodha Kite Connect
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
# Upstox
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=
# Dhan
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Angel One SmartAPI
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PIN=
ANGELONE_TOTP_SECRET=
# Fyers
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_ACCESS_TOKEN=
# Kotak Neo
KOTAK_CONSUMER_KEY=
KOTAK_MOBILE=
KOTAK_UCC=
KOTAK_MPIN=
KOTAK_TOTP_SECRET=
# ICICI Direct Breeze
ICICI_API_KEY=
ICICI_API_SECRET=
ICICI_SESSION_TOKEN=
# Noren OMS family (Shoonya/Finvasia, Flattrade, Zebu, Tradejini)
NOREN_BROKER=shoonya
NOREN_USER_ID=
NOREN_API_KEY=
NOREN_VENDOR_CODE=
NOREN_TOTP_SECRET=
# Others (5paisa, Alice Blue, IIFL, Groww, Motilal Oswal, Paytm Money, Nuvama, SAMCO, mStock, Definedge, Sharekhan)
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCESS_TOKEN=

# ---------- Notifications ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EXPO_ACCESS_TOKEN=

# ---------- Observability ----------
SENTRY_DSN=

# ---------- Historical data (TimescaleDB) ----------
TIMESCALE_URL=postgres://atb:atb@localhost:5432/atb_market
